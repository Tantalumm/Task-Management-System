generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model tags {
  id         Int         @id @default(autoincrement())
  name       String      @unique(map: "name") @db.VarChar(50)
  created_at DateTime?   @default(now()) @db.Timestamp(0)
  task_tags  task_tags[]
}

model task_tags {
  task_id    Int
  tag_id     Int
  created_at DateTime? @default(now()) @db.Timestamp(0)
  tasks      tasks     @relation(fields: [task_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "task_tags_ibfk_1")
  tags       tags      @relation(fields: [tag_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "task_tags_ibfk_2")

  @@id([task_id, tag_id])
  @@index([tag_id], map: "idx_tag")
  @@index([task_id], map: "idx_task")
}

model tasks {
  id          Int             @id @default(autoincrement())
  title       String          @db.VarChar(255)
  description String?         @db.Text
  status      tasks_status?   @default(todo)
  priority    tasks_priority? @default(medium)
  due_date    DateTime?       @db.Date
  created_at  DateTime?       @default(now()) @db.Timestamp(0)
  updated_at  DateTime?       @default(now()) @db.Timestamp(0)
  task_tags   task_tags[]

  @@index([due_date], map: "idx_due_date")
  @@index([priority], map: "idx_priority")
  @@index([status], map: "idx_status")
}

enum tasks_status {
  todo
  in_progress
  done
}

enum tasks_priority {
  low
  medium
  high
}
